# VITE_TMDB_API_KEY: API key (v3 auth) from The Movie Database (https://www.themoviedb.org/settings/api).
# Leave unset to use CineScope in Demo Mode.
VITE_TMDB_API_KEY=""

# KINOPOISK_API_KEY: API key from Kinopoisk Unofficial API (https://kinopoiskapiunofficial.tech).
# Used strictly on the server side to match TMDB titles with Kinopoisk IDs.
KINOPOISK_API_KEY=""

# PORT: Local server port (defaults to 3000)
PORT=3000
